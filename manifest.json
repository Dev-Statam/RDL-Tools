{
    "manifest_version": 3,
    "name": "RDL Tools",
    "version": "1.0",

    "description": "Extension permettant de copier chaque journée de le presse-papier afin de les coller dans son agenda",

    "icons": {
        "16": "icons/rdl-tools-16.png",
        "32": "icons/rdl-tools-32.png"
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "rdl-tools@steveamat.fr"
        }
    },

    "permissions": [
        "clipboardWrite"
    ],

    "content_scripts": [
        {
            "matches": ["https://srv-voitures.ml.tcl.fr/roulement"],
            "js": ["scripts/content.js"]
        }
    ]
}