{
    "manifest_version": 2,
    "name": "RDL Tools",
    "author": "Steve Amat",
    "version": "2.1",

    "description": "Extension qui permet de créer des fichiers .ics de ses jours de travail et de rpos afin de les ajouter à son calendrier. Cette extension est destinée à une utilisation personnelle par son auteur et n'est pas destinée à être publier ni distribuée.",

    "icons": {
        "16": "icons/rdl-tools-16.png",
        "32": "icons/rdl-tools-32.png"
    },

    "permissions": [
        
    ],

    "browser_specific_settings": {
        "gecko": {
            "id": "rdl-toolsV2@steveamat.fr",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "content_scripts": [
        {
            "matches": ["https://srv-voitures.ml.tcl.fr/roulement"],
            "js": ["scripts/content.js"]
        }
    ],

    "web_accessible_resources": [
        "icons/calendrier-24.png",
        "icons/repos-50.png"
    ]
}